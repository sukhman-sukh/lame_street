# ─── Secrets ───────────────────────────────────────────────────────────────
# Mailbox addresses, Gmail app passwords, statement passwords.
.env
.env.*
!.env.example

# Holds real names and email addresses. Ship config.example.json instead.
config.json
config.*.json
!config.example.json

# ─── Personal financial data ───────────────────────────────────────────────
# Archived broker email, statement PDFs, the event log, derived holdings,
# price cache and the built dashboard. None of this belongs in a repository.
data/
profiles/

# Broker statements and exports, wherever they land
*.pdf
*.PDF
*.csv
*.xlsx
*.xls

# Static export of the dashboard — contains real positions
dist/

