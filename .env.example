# LameStreet — optional seed file for a fresh deployment. Gitignored.
#
#   cp .env.example .env
#
# config.json is the real store: the app writes to it, so people and credentials
# added through the UI persist across restarts and redeployments. This file only
# fills gaps that config.json does not already have — useful for standing up a
# new instance without typing anything in. Once loaded, run
#
#   python -m pm secrets adopt
#
# to persist the values into config.json, after which .env can be deleted.
# config.json always wins where it has a value, so a stale .env can never
# override a credential someone entered in the UI.
#
# Suffixes are the member id in capitals, with non-alphanumerics as underscores:
#   member id "mary-jane"  ->  suffix MARY_JANE
# Member ids are shown by:  python -m pm member list


# ─── Per person ──────────────────────────────────────────────────────────────
# PM_MAIL_USER_<ID>       the Gmail address whose inbox holds their statements
# PM_MAIL_PASSWORD_<ID>   16-character Google app password (NOT the account
#                         password — Gmail stopped accepting those for IMAP).
#                         Create one at myaccount.google.com/apppasswords
# PM_DOC_PASSWORD_<ID>    what opens their broker PDFs, usually their PAN in
#                         capitals. Must be unique per person: it is also how
#                         the app tells whose statement is whose.
#                         Comma-separate if brokers use different passwords.

PM_MAIL_USER_ALICE=alice@gmail.com
PM_MAIL_PASSWORD_ALICE=abcdefghijklmnop
PM_DOC_PASSWORD_ALICE=ABCDE1234F

PM_MAIL_USER_BOB=bob@gmail.com
PM_MAIL_PASSWORD_BOB=qrstuvwxyzabcdef
PM_DOC_PASSWORD_BOB=PQRSX6789K


# ─── Shared inbox (optional alternative) ─────────────────────────────────────
# If everyone forwards their broker mail to one dedicated address, set these
# instead of the per-person values above. That mailbox then only ever contains
# broker mail, so the app cannot see anyone's personal email.
# PM_MAIL_USER=familyportfolio@gmail.com
# PM_MAIL_PASSWORD=


# ─── Server ──────────────────────────────────────────────────────────────────
# 127.0.0.1 keeps the dashboard on this machine. 0.0.0.0 exposes it to every
# device on the network, with no login in front of it.
PM_HOST=127.0.0.1
PM_PORT=3002


# ─── Optional ────────────────────────────────────────────────────────────────
# Only used to help read a broker layout nobody has profiled yet. Never used to
# extract numbers from a broker that is already profiled — those are pure code.
# ANTHROPIC_API_KEY=
